// Sphere
double getSphereVolume(double radius)
{
    return (4.0 / 3.0) * PI * pow(radius, 3.0);
}

double getSphereSurfaceArea(double radius)
{
    return 4.0 * PI * pow(radius, 2.0);
}

// Tetrahedron
double getTetrahedronVolume(double side)
{
    return pow(side, 3.0) * sqrt(3.0) / 12.0;
}

double getTetrahedronSurfaceArea(double side)
{
    return sqrt(3.0) * pow(side, 2.0);
}

// Hexahedron
double getHexahedronVolume(double side)
{
    return pow(side, 3.0);
}

double getHexahedronSurfaceArea(double side)
{
    return 6.0 * pow(side, 2.0);
}

// Octahedron
double getOctahedronVolume(double side)
{
    return sqrt(2.0) / 3.0 * pow(side, 3.0);
}

double getOctahedronSurfaceArea(double side)
{
    return 2.0 * sqrt(3.0) * pow(side, 2.0);
}

// Dodecahedron
double getDodecahedronVolume(double side)
{
    return (15.0 + 7.0 * sqrt(5.0)) / 4.0 * pow(side, 3.0);
}

double getDodecahedronSurfaceArea(double side)
{
    return 3.0 * sqrt(25.0 + 10.0 * sqrt(5.0)) * pow(side, 2.0);
}

// Icosahedron
double getIcosahedronVolume(double side)
{
    return 5.0 * (3.0 + sqrt(5.0)) / 12.0 * pow(side, 3.0);
}

double getIcosahedronSurfaceArea(double side)
{
    return 5.0 * sqrt(3.0) * pow(side, 2.0);
}

// Selection sort
void sortAscending(vector<double>& values)
{
    for (int start = 0; start < static_cast<int>(values.size()) - 1; start++)
    {
        int minIndex = start;

        for (int i = start + 1; i < static_cast<int>(values.size()); i++)
        {
            if (values[i] < values[minIndex])
                minIndex = i;
        }

        if (minIndex != start)
        {
            double temp = values[start];
            values[start] = values[minIndex];
            values[minIndex] = temp;
        }
    }
}

// Surface area for one shape
double surfaceAreaFor(char shape, double measurement)
{
    switch (shape)
    {
    case 'S': return getSphereSurfaceArea(measurement);
    case 'T': return getTetrahedronSurfaceArea(measurement);
    case 'H': return getHexahedronSurfaceArea(measurement);
    case 'O': return getOctahedronSurfaceArea(measurement);
    case 'D': return getDodecahedronSurfaceArea(measurement);
    case 'I': return getIcosahedronSurfaceArea(measurement);
    }
    return 0;
}

// Volume for one shape
double volumeFor(char shape, double measurement)
{
    switch (shape)
    {
    case 'S': return getSphereVolume(measurement);
    case 'T': return getTetrahedronVolume(measurement);
    case 'H': return getHexahedronVolume(measurement);
    case 'O': return getOctahedronVolume(measurement);
    case 'D': return getDodecahedronVolume(measurement);
    case 'I': return getIcosahedronVolume(measurement);
    }
    return 0;
}

// Smallest and largest volume
void checkShapeExtremes(vector<double> data, char shape, string name, bool& found,
    double& smallestVolume, int& smallestIndex, string& smallestName,
    double& largestVolume, int& largestIndex, string& largestName)
{
    if (data.size() == 0)
        return;

    sortAscending(data);

    int last = static_cast<int>(data.size()) - 1;
    double small = volumeFor(shape, data[0]);
    double large = volumeFor(shape, data[last]);

    if (!found)
    {
        found = true;
        smallestVolume = small;
        smallestIndex = 0;
        smallestName = name;
        largestVolume = large;
        largestIndex = last;
        largestName = name;
    }
    else
    {
        if (small < smallestVolume)
        {
            smallestVolume = small;
            smallestIndex = 0;
            smallestName = name;
        }
        if (large > largestVolume)
        {
            largestVolume = large;
            largestIndex = last;
            largestName = name;
        }
    }
}

// Print one sorted shape
void outputSortedShape(char destination, string fileName, char shape, vector<double> data)
{
    sortAscending(data);

    string name;
    string measurementName = "edge length";

    switch (shape)
    {
    case 'S': name = "Sphere"; measurementName = "radius"; break;
    case 'T': name = "Tetrahedron"; break;
    case 'H': name = "Hexahedron"; break;
    case 'O': name = "Octahedron"; break;
    case 'D': name = "Dodecahedron"; break;
    case 'I': name = "Icosahedron"; break;
    }

    // Console output
    if (destination == 'C')
    {
        cout << "\n\t" << shape << ". (sorted) " << name << " vector:\n\n";
        cout << scientific << showpoint << setprecision(6) << right;
        cout << "\t" << setw(10) << "index"
            << setw(20) << measurementName
            << setw(20) << "surface area"
            << setw(20) << "volume" << "\n";
        cout << "\t" << string(10, char(196))
            << setw(20) << string(19, char(196))
            << setw(20) << string(19, char(196))
            << setw(20) << string(19, char(196)) << "\n";

        for (int i = 0; i < static_cast<int>(data.size()); i++)
        {
            string marker = " ";
            if (i == 0)
                marker = "-";
            else if (i == static_cast<int>(data.size()) - 1)
                marker = "+";

            cout << "\t" << left << setw(1) << marker << right
                << setw(9) << i
                << setw(20) << data[i]
                << setw(20) << surfaceAreaFor(shape, data[i])
                << setw(20) << volumeFor(shape, data[i]) << "\n";
        }
    }
    // File output
    else if (destination == 'F')
    {
        ofstream outFile;
        outFile.open(fileName);

        if (outFile)
        {
            outFile << "\n\t" << shape << ". (sorted) " << name << " vector:\n\n";
            outFile << scientific << showpoint << setprecision(6) << right;

            outFile << "\t" << setw(10) << "index"
                << setw(20) << measurementName
                << setw(20) << "surface area"
                << setw(20) << "volume" << "\n";
            outFile << "\t" << string(10, char(196))
                << setw(20) << string(19, char(196))
                << setw(20) << string(19, char(196))
                << setw(20) << string(19, char(196)) << "\n";

            for (int i = 0; i < static_cast<int>(data.size()); i++)
            {
                string marker = " ";
                if (i == 0)
                    marker = "-";
                else if (i == static_cast<int>(data.size()) - 1)
                    marker = "+";

                outFile << "\t" << left << setw(1) << marker << right
                    << setw(9) << i
                    << setw(20) << data[i]
                    << setw(20) << surfaceAreaFor(shape, data[i])
                    << setw(20) << volumeFor(shape, data[i]) << "\n";
            }

            outFile.close();
            cout << "\nCONFIRMATION: Data written to " << fileName << ".\n\n";
        }
        else
        {
            cout << "\nERROR: File cannot be created.\n\n\n";
        }
    }
}
